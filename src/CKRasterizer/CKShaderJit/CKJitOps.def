// Shader IR operations: CKJIT_OP(NAME, operands, flags). A VARIADIC operation
// takes from two up to that many operands.
//
// Every value is a pure function of its operands; structured regions (IF and
// LOOP below) only decide which of them a shader invocation computes, and how often.
// QUAD operations read the pixel's quad neighbours, so they run only in fragment
// programs where control flow is uniform (see CKJitIR.h). Operations are
// component-wise over operands of one type unless noted, and comparisons
// produce BOOLs of their operands' width. Keep this list in sync with the
// operand and type rules in CKJitBuilder and with every backend.

// Leaves. CONSTANT holds the component bit patterns in Imm[0..3], INPUT the
// shader input index in Imm[0], UNIFORM the float4 row Imm[0] of uniform
// buffer Imm[1].
CKJIT_OP(CONSTANT,   0, 0)
CKJIT_OP(INPUT,      0, 0)
CKJIT_OP(UNIFORM,    0, 0)

// Component routing. SWIZZLE selects Imm[i] of its operand for component i
// (a scalar operand only has component 0, so it also expresses splats).
// CONSTRUCT concatenates the components of its operands, all of one kind.
CKJIT_OP(SWIZZLE,    1, 0)
CKJIT_OP(CONSTRUCT,  4, CKJIT_OPFLAG_VARIADIC)

// Float arithmetic uses binary32. The host's FP rounding mode is not shader
// state. ROUND_EVEN rounds to the nearest integer, ties to even, preserving
// signed zero. NaN payloads, denormal preservation and the accuracy of DIV,
// DOT and transcendental functions depend on the backend; this is not a
// bit-exact cross-device arithmetic contract. Algebraic identities must not
// change zero signs or assume finite operands.
CKJIT_OP(ADD,        2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(SUB,        2, 0)
CKJIT_OP(MUL,        2, CKJIT_OPFLAG_COMMUTATIVE)
// MAD(a,b,c) preserves a native multiply-add. It may round differently from
// separate MUL/ADD and is never folded or reassociated by the builder.
CKJIT_OP(MAD,        3, 0)
CKJIT_OP(DIV,        2, 0)
CKJIT_OP(MIN,        2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(MAX,        2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(NEG,        1, 0)
CKJIT_OP(ABS,        1, 0)
CKJIT_OP(SATURATE,   1, 0)
CKJIT_OP(FLOOR,      1, 0)
CKJIT_OP(CEIL,       1, 0)
CKJIT_OP(ROUND_EVEN, 1, 0)
CKJIT_OP(EXP2,       1, 0)
CKJIT_OP(LOG2,       1, 0)
CKJIT_OP(SQRT,       1, 0)
CKJIT_OP(DOT,        2, CKJIT_OPFLAG_COMMUTATIVE)

// Screen-space derivatives: the difference across the pixel quad along x or
// y, at the precision of HLSL ddx and ddy.
CKJIT_OP(DDX,        1, CKJIT_OPFLAG_QUAD)
CKJIT_OP(DDY,        1, CKJIT_OPFLAG_QUAD)

// Float comparisons. LT, LE and EQ are ordered (false when either operand is
// NaN); NE is unordered, like HLSL and GLSL "!=".
CKJIT_OP(LT,         2, 0)
CKJIT_OP(LE,         2, 0)
CKJIT_OP(EQ,         2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(NE,         2, CKJIT_OPFLAG_COMMUTATIVE)

// Integers. FTOI truncates toward zero; its portable domain is finite values
// whose truncated result fits int32 (-2^31 <= x < 2^31 for binary32). Outside
// that domain the result is backend-dependent, not guaranteed to saturate.
// ITOF converts back, with backend-dependent rounding if not exactly
// representable. IADD, ISUB and IMUL wrap around. IMOD is the floored remainder (it has
// the sign of the divisor), defined for positive divisors only. ISHR is
// arithmetic and shifts by the low five bits of its count.
CKJIT_OP(FTOI,       1, 0)
CKJIT_OP(ITOF,       1, 0)
CKJIT_OP(IADD,       2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(ISUB,       2, 0)
CKJIT_OP(IMUL,       2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(IMIN,       2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(IMAX,       2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(IMOD,       2, 0)
CKJIT_OP(IAND,       2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(ISHR,       2, 0)

// Integer comparisons.
CKJIT_OP(ILT,        2, 0)
CKJIT_OP(ILE,        2, 0)
CKJIT_OP(IEQ,        2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(INE,        2, CKJIT_OPFLAG_COMMUTATIVE)

// Booleans. ANY and ALL reduce a BOOL2..BOOL4 to a BOOL.
CKJIT_OP(AND,        2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(OR,         2, CKJIT_OPFLAG_COMMUTATIVE)
CKJIT_OP(NOT,        1, 0)
CKJIT_OP(ANY,        1, 0)
CKJIT_OP(ALL,        1, 0)

// SELECT(condition, whenTrue, whenFalse): a BOOL condition picks whole arms,
// one of the arms' width picks per component.
CKJIT_OP(SELECT,     3, 0)

// A structured region: IF(condition) runs the then arm where the BOOL holds,
// ELSE(if) ends it and runs the else arm elsewhere, ENDIF(else) ends that.
// The markers are VOID and bracket their arms in the node order; an arm's
// nodes read only nodes of the arms enclosing them. The PHIs directly after
// an ENDIF are the region's results: PHI(whenThen, whenElse, endif) is the
// then value where the condition held and the else value elsewhere, each of
// its arm or from before the region.
CKJIT_OP(IF,         1, CKJIT_OPFLAG_MARKER)
CKJIT_OP(ELSE,       1, CKJIT_OPFLAG_MARKER)
CKJIT_OP(ENDIF,      1, CKJIT_OPFLAG_MARKER)
CKJIT_OP(PHI,        3, 0)

// A bounded loop: LOOP(count) runs its body for each iteration below the INT
// count and below Imm[0], its bound (1..2^31 - 1), and ENDLOOP(loop) ends the
// body; the markers bracket it as they do an arm. An optional INDEX and then
// the CARRYs directly after a LOOP head its body: INDEX(loop) is the INT
// iteration, from 0, and CARRY(initial, loop) a value passed from one
// iteration to the next, the initial from before the loop in the first. The
// RESULTs directly after an ENDLOOP, one for each CARRY in order, bind them:
// RESULT(carry, next, endloop) makes next, of the body or from before the
// loop, the carry's value in the following iteration, and is the carry's
// value once the loop ends (the initial when it runs no iteration).
CKJIT_OP(LOOP,       1, CKJIT_OPFLAG_MARKER)
CKJIT_OP(INDEX,      1, 0)
CKJIT_OP(CARRY,      2, 0)
CKJIT_OP(ENDLOOP,    1, CKJIT_OPFLAG_MARKER)
CKJIT_OP(RESULT,     3, 0)

// Texture access through sampler slot Imm[0] with dimension Imm[1]
// (CKJitSamplerDim); a slot has one dimension. Coordinates are FLOAT2 for 2D
// and 2D_COMPARE slots and FLOAT3 for cube directions and volume coordinates,
// derivatives have the coordinate's type, LODs and biases are FLOATs.
//
// SAMPLE(coordinate, lodBias) takes the LOD from the coordinate's quad
// derivatives, SAMPLE_LEVEL(coordinate, lod) and SAMPLE_GRAD(coordinate, dx,
// dy) take it explicitly; all three are FLOAT4. CALC_LOD(coordinate) is the
// FLOAT LOD SAMPLE would compute, before clamping.
CKJIT_OP(SAMPLE,       2, CKJIT_OPFLAG_TEXTURE | CKJIT_OPFLAG_QUAD)
CKJIT_OP(SAMPLE_LEVEL, 2, CKJIT_OPFLAG_TEXTURE)
CKJIT_OP(SAMPLE_GRAD,  3, CKJIT_OPFLAG_TEXTURE)
CKJIT_OP(CALC_LOD,     1, CKJIT_OPFLAG_TEXTURE | CKJIT_OPFLAG_QUAD)

// Depth comparison, the only access that samples a 2D_COMPARE slot:
// SAMPLE_CMP(coordinate, reference) is the FLOAT filtered result of comparing
// the reference with the texels, at the LOD SAMPLE would take;
// SAMPLE_CMP_LEVEL_ZERO(coordinate, reference) compares at the base mip.
CKJIT_OP(SAMPLE_CMP,            2, CKJIT_OPFLAG_TEXTURE | CKJIT_OPFLAG_QUAD)
CKJIT_OP(SAMPLE_CMP_LEVEL_ZERO, 2, CKJIT_OPFLAG_TEXTURE)

// Unfiltered access, apart from the sampler state. LOAD(texel) reads the
// FLOAT4 at an INT3 (x, y, mip) of a 2D or 2D_COMPARE slot or an INT4 (x, y,
// z, mip) of a volume slot, for texels within the mip only (no cube).
// SIZE(mip) is the INT2 (INT3 for volumes) extent of a mip below LEVELS(), the
// INT mip count.
CKJIT_OP(LOAD,         1, CKJIT_OPFLAG_TEXTURE)
CKJIT_OP(SIZE,         1, CKJIT_OPFLAG_TEXTURE)
CKJIT_OP(LEVELS,       0, CKJIT_OPFLAG_TEXTURE)
