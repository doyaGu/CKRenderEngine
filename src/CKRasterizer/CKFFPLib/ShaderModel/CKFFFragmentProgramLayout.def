// Single source of the CPU-resolved fixed-function fragment program layout.
//
// The fragment program is CKFF_FRAGMENT_PROGRAM_LANE_COUNT lanes of
// CKFF_FRAGMENT_PROGRAM_LANE_BITS bits. Each lane travels as one float
// component of u_ffProgram (an integer below 2^24 is exact in fp32 on every
// shader profile), so the shader reads a lane with int() and slices it with
// shifts and masks. Texture stage s owns lanes
// CKFF_FRAGMENT_PROGRAM_STAGE_LANE_BASE + s * CKFF_FRAGMENT_PROGRAM_STAGE_LANE_STRIDE (+ laneInStage);
// the global fields follow at CKFF_FRAGMENT_PROGRAM_GLOBAL_LANE_BASE.
//
// Included by CKFFFragmentProgramLayout.h (C++ enums and layout tables) and parsed by
// compile_shaders.py to generate shaders/ff_fragment_program_layout.sh (GLSL accessors).
// Fields never straddle a lane. Operation and argument fields hold the 5-bit
// repacked values (see CKFFFragmentProgram::RepackArg).
//
//   CKFF_FRAGMENT_PROGRAM_CONST(NAME, value)
//   CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(NAME, laneInStage, bitOffset, bitCount)
//   CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(NAME, lane, bitOffset, bitCount)

CKFF_FRAGMENT_PROGRAM_CONST(LANE_BITS, 24)
CKFF_FRAGMENT_PROGRAM_CONST(LANE_COUNT, 20)
CKFF_FRAGMENT_PROGRAM_CONST(VEC4_COUNT, 5)
CKFF_FRAGMENT_PROGRAM_CONST(STAGE_COUNT, 8)
CKFF_FRAGMENT_PROGRAM_CONST(STAGE_LANE_BASE, 0)
CKFF_FRAGMENT_PROGRAM_CONST(STAGE_LANE_STRIDE, 2)
CKFF_FRAGMENT_PROGRAM_CONST(GLOBAL_LANE_BASE, 16)

// Stage lane 0: colour combiner, result register, sampler kind.
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(COLOR_OP,             0,  0, 5)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(COLOR_ARG1,           0,  5, 5)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(COLOR_ARG2,           0, 10, 5)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(COLOR_ARG0,           0, 15, 5)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(RESULT_IS_TEMP,       0, 20, 1)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(SAMPLER_TYPE,         0, 21, 2)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(PROJECTED,            0, 23, 1)

// Stage lane 1: alpha combiner, shader-side depth compare.
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(ALPHA_OP,             1,  0, 5)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(ALPHA_ARG1,           1,  5, 5)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(ALPHA_ARG2,           1, 10, 5)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(ALPHA_ARG0,           1, 15, 5)
CKFF_FRAGMENT_PROGRAM_STAGE_FIELD(SAMPLER_COMPARE_FUNC, 1, 20, 4)

// Global lane 16: stage chain length, alpha test, fog, shading.
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(LAST_ACTIVE_TEXTURE_STAGE, 16,  0, 3)
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(ALPHA_TEST_ENABLED,        16,  3, 1)
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(ALPHA_FUNC,                16,  4, 4)
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(FOG_ENABLED,               16,  8, 1)
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(VERTEX_FOG_MODE,           16,  9, 2)
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(PIXEL_FOG_MODE,            16, 11, 2)
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(RANGE_FOG,                 16, 13, 1)
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(FLAT_SHADE,                16, 14, 1)
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(GLOBAL_SPECULAR_ENABLED,   16, 15, 1)

// Global lane 17: native resource ordinal, 3 bits per stage.
CKFF_FRAGMENT_PROGRAM_GLOBAL_FIELD(SAMPLER_ORDINALS,          17,  0, 24)

// Lanes 18 and 19 are reserved.
