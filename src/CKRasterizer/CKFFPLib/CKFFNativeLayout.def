// Ordered native buffer members. Consumed by C++ and the offline compiler.
// The four vertex variants share the union of their inputs in one buffer.
CKFF_NATIVE_BLOCK(VERTEX, MATRICES)
CKFF_NATIVE_BLOCK(VERTEX, VERTEX_BLEND_MATRICES)
CKFF_NATIVE_BLOCK(VERTEX, DRAW_PARAMS)
CKFF_NATIVE_BLOCK(VERTEX, TEX_MATRICES)
CKFF_NATIVE_BLOCK(VERTEX, LIGHTS)
CKFF_NATIVE_BLOCK(VERTEX, VIEWPORT)
CKFF_NATIVE_BLOCK(VERTEX, STAGE_PARAMS)
CKFF_NATIVE_BLOCK(VERTEX, CLIP_PLANES)
CKFF_NATIVE_BLOCK(VERTEX, CLIP_PARAMS)
CKFF_NATIVE_BLOCK(FRAGMENT, DRAW_PARAMS)
CKFF_NATIVE_BLOCK(FRAGMENT, BUMP_ENV)
CKFF_NATIVE_BLOCK(FRAGMENT, STAGE_PARAMS)
CKFF_NATIVE_BLOCK(FRAGMENT, SPEC)
CKFF_NATIVE_METADATA(FRAGMENT, 16)
CKFF_NATIVE_BLOCK(PRESENT, PRESENT_PARAMS)
CKFF_NATIVE_METADATA(PRESENT, 1)
