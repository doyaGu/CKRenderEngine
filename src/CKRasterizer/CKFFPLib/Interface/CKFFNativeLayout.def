// Ordered native buffer members. Consumed by C++ and the offline compiler.
// Per-draw matrices are isolated so changing world transforms does not copy
// and push the complete vertex-stage constant payload.
CKFF_NATIVE_BLOCK(VERTEX, 0, MATRICES)
CKFF_NATIVE_BLOCK(VERTEX, 1, VERTEX_BLEND_MATRICES)
CKFF_NATIVE_BLOCK(VERTEX, 1, DRAW_PARAMS)
CKFF_NATIVE_BLOCK(VERTEX, 1, TEX_MATRICES)
CKFF_NATIVE_BLOCK(VERTEX, 1, LIGHTS)
CKFF_NATIVE_BLOCK(VERTEX, 1, VIEWPORT)
CKFF_NATIVE_BLOCK(VERTEX, 1, STAGE_PARAMS)
CKFF_NATIVE_BLOCK(VERTEX, 1, CLIP_PLANES)
CKFF_NATIVE_BLOCK(VERTEX, 1, CLIP_PARAMS)
CKFF_NATIVE_BLOCK(FRAGMENT, 0, DRAW_PARAMS)
CKFF_NATIVE_BLOCK(FRAGMENT, 0, BUMP_ENV)
CKFF_NATIVE_BLOCK(FRAGMENT, 0, STAGE_PARAMS)
CKFF_NATIVE_BLOCK(FRAGMENT, 0, FRAGMENT_PROGRAM)
CKFF_NATIVE_METADATA(FRAGMENT, 0, 16)
CKFF_NATIVE_BLOCK(PRESENT, 0, PRESENT_PARAMS)
CKFF_NATIVE_METADATA(PRESENT, 0, 1)
