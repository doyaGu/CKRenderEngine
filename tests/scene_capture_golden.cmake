# Baselines are reviewed versioned fixtures. A test run never updates them.
if (NOT "$ENV{CKRE_SCENE_CAPTURE_SKIP}" STREQUAL "" OR SKIP)
    message(FATAL_ERROR "Scene exclusions are not allowed in the acceptance suite")
endif ()
if ("$ENV{CKRE_UPDATE_GOLDEN}" STREQUAL "1")
    message(FATAL_ERROR "Capture reference images separately before running tests")
endif ()
get_filename_component(_references "${GOLDEN_ROOT}" REALPATH)
get_filename_component(_output "${OUT_DIR}" REALPATH)
if (CMAKE_HOST_WIN32)
    string(TOLOWER "${_references}" _references)
    string(TOLOWER "${_output}" _output)
endif ()
string(FIND "${_output}/" "${_references}/" _inside_references)
string(FIND "${_references}/" "${_output}/" _contains_references)
if (_inside_references EQUAL 0 OR _contains_references EQUAL 0)
    message(FATAL_ERROR "Capture output and reviewed reference directories must not overlap")
endif ()
string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" _platform)
set(_golden "${GOLDEN_ROOT}/${_platform}")
file(MAKE_DIRECTORY "${OUT_DIR}")
set(_capture "${TOOL}" --render-engine-dir "${ENGINE_DIR}"
    --rasterizer sdlgpu --scene all --size 640x480 --frames 5 --capture-frames 5 --out "${OUT_DIR}")
if (NOT EXISTS "${_golden}/baseline.json")
    execute_process(COMMAND ${_capture} RESULT_VARIABLE _capture_result)
    message(FATAL_ERROR "Missing reviewed scene baseline for ${_platform}: ${_golden}; candidate frames (${_capture_result}) are in ${OUT_DIR}")
endif ()
file(READ "${_golden}/baseline.json" _baseline)
string(JSON _format GET "${_baseline}" format)
if (NOT _format EQUAL 1 AND NOT _format EQUAL 2)
    message(FATAL_ERROR "Unsupported scene baseline format: ${_format}")
endif ()
string(JSON _count LENGTH "${_baseline}" scenes)
if (_count LESS 1)
    message(FATAL_ERROR "The scene baseline is empty")
endif ()
function(check_scene_reference _path _expected)
    if (NOT EXISTS "${_path}")
        message(FATAL_ERROR "Missing reviewed scene reference: ${_path}")
    endif ()
    file(SHA256 "${_path}" _actual)
    if (NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Scene reference changed without its manifest: ${_path}")
    endif ()
endfunction()

function(scene_variant_count _index _result)
    string(JSON _type ERROR_VARIABLE _error TYPE "${_baseline}" scenes ${_index} variants)
    set(_variants 0)
    if (NOT _error)
        if (NOT _format EQUAL 2 OR NOT _type STREQUAL "ARRAY")
            message(FATAL_ERROR "Scene reference variants require a format 2 array")
        endif ()
        string(JSON _variants LENGTH "${_baseline}" scenes ${_index} variants)
    endif ()
    set(${_result} "${_variants}" PARENT_SCOPE)
endfunction()

set(_expected_images ${_count})
set(_reference_scenes)
math(EXPR _last "${_count} - 1")
foreach (_index RANGE 0 ${_last})
    string(JSON _scene GET "${_baseline}" scenes ${_index} name)
    if (NOT _scene MATCHES "^[a-z0-9_]+$")
        message(FATAL_ERROR "Invalid scene baseline name: ${_scene}")
    endif ()
    list(APPEND _reference_scenes "${_scene}")
    string(JSON _expected GET "${_baseline}" scenes ${_index} sha256)
    check_scene_reference("${_golden}/${_scene}.png" "${_expected}")
    scene_variant_count(${_index} _variants)
    if (_variants GREATER 0)
        math(EXPR _variant_last "${_variants} - 1")
        foreach (_variant_index RANGE 0 ${_variant_last})
            string(JSON _variant GET "${_baseline}" scenes ${_index} variants ${_variant_index} name)
            if (NOT _variant MATCHES "^[a-z0-9_]+$")
                message(FATAL_ERROR "Invalid scene reference variant: ${_variant}")
            endif ()
            string(JSON _expected GET "${_baseline}" scenes ${_index} variants ${_variant_index} sha256)
            check_scene_reference("${_golden}/variants/${_variant}/${_scene}.png" "${_expected}")
            math(EXPR _expected_images "${_expected_images} + 1")
        endforeach ()
    endif ()
endforeach ()
file(GLOB_RECURSE _images "${_golden}/*.png")
list(LENGTH _images _image_count)
if (NOT _expected_images EQUAL _image_count)
    message(FATAL_ERROR "The scene baseline manifest does not cover every image exactly once")
endif ()

execute_process(COMMAND "${TOOL}" --list-scenes RESULT_VARIABLE _list_result OUTPUT_VARIABLE _listing)
if (NOT "${_list_result}" STREQUAL "0")
    message(FATAL_ERROR "Cannot enumerate scene fixtures: ${_list_result}")
endif ()
string(REGEX MATCHALL "[^\r\n]+" _lines "${_listing}")
set(_registered_scenes)
foreach (_line IN LISTS _lines)
    if (_line MATCHES "^([a-z0-9_]+)[ \t]+oracle=")
        list(APPEND _registered_scenes "${CMAKE_MATCH_1}")
    endif ()
endforeach ()
list(SORT _registered_scenes)
list(SORT _reference_scenes)
if (NOT _registered_scenes OR NOT _registered_scenes STREQUAL _reference_scenes)
    message(FATAL_ERROR "The scene baseline must cover every registered scene exactly once")
endif ()

execute_process(COMMAND ${_capture} RESULT_VARIABLE _capture_result)
if (NOT "${_capture_result}" STREQUAL "0")
    message(FATAL_ERROR "Scene capture failed: ${_capture_result}; see ${OUT_DIR}")
endif ()
set(_failed_scenes)
foreach (_index RANGE 0 ${_last})
    string(JSON _scene GET "${_baseline}" scenes ${_index} name)
    set(_reference_directories "${_golden}")
    scene_variant_count(${_index} _variants)
    if (_variants GREATER 0)
        math(EXPR _variant_last "${_variants} - 1")
        foreach (_variant_index RANGE 0 ${_variant_last})
            string(JSON _variant GET "${_baseline}" scenes ${_index} variants ${_variant_index} name)
            list(APPEND _reference_directories "${_golden}/variants/${_variant}")
        endforeach ()
    endif ()
    set(_matched FALSE)
    set(_attempt_reports "")
    foreach (_reference IN LISTS _reference_directories)
        execute_process(COMMAND "${TOOL}" --compare-only --scene "${_scene}"
            --out "${OUT_DIR}" --compare "${_reference}" --threshold 2 --min-pass 0.995
            RESULT_VARIABLE _result OUTPUT_VARIABLE _report ERROR_VARIABLE _error)
        if ("${_result}" STREQUAL "0")
            message(STATUS "${_scene}: matched ${_reference}\n${_report}")
            set(_matched TRUE)
            break()
        endif ()
        string(APPEND _attempt_reports "${_reference}\n${_report}${_error}\n")
        if (NOT "${_result}" STREQUAL "5")
            break()
        endif ()
    endforeach ()
    if (NOT _matched)
        list(APPEND _failed_scenes "${_scene}")
        message(STATUS "${_scene}: no complete reference frame matched\n${_attempt_reports}")
    endif ()
endforeach ()
if (_failed_scenes)
    message(FATAL_ERROR "Scene regression failed: ${_failed_scenes}; see ${OUT_DIR}")
endif ()
