{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-win32-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "msvc-x64-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "renderengine-runtime-msvc-win32",
      "displayName": "RenderEngine Runtime (MSVC Win32)",
      "description": "Build the SDL_gpu rasterizer runtime using shared libraries.",
      "inherits": "msvc-win32-base",
      "cacheVariables": {
        "CKRE_BUILD_SHARED": "ON",
        "CKRE_BUILD_STATIC": "OFF",
        "CKRE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "renderengine-runtime-msvc-x64",
      "displayName": "RenderEngine Runtime (MSVC x64)",
      "description": "Build the x64 SDL_gpu rasterizer runtime using shared libraries.",
      "inherits": "msvc-x64-base",
      "cacheVariables": {
        "CKRE_BUILD_SHARED": "ON",
        "CKRE_BUILD_STATIC": "OFF",
        "CKRE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "renderengine-static-msvc-win32",
      "displayName": "RenderEngine Static (MSVC Win32)",
      "description": "Build static RenderEngine and SDL_gpu rasterizer libraries.",
      "inherits": "msvc-win32-base",
      "cacheVariables": {
        "CKRE_BUILD_SHARED": "OFF",
        "CKRE_BUILD_STATIC": "ON",
        "CKRE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "renderengine-static-msvc-x64",
      "displayName": "RenderEngine Static (MSVC x64)",
      "description": "Build x64 static RenderEngine and SDL_gpu rasterizer libraries.",
      "inherits": "msvc-x64-base",
      "cacheVariables": {
        "CKRE_BUILD_SHARED": "OFF",
        "CKRE_BUILD_STATIC": "ON",
        "CKRE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "renderengine-tests-msvc-win32",
      "displayName": "RenderEngine Tests (MSVC Win32)",
      "description": "Build v2 RenderEngine tests against static CKRenderEngine libraries.",
      "inherits": "renderengine-static-msvc-win32",
      "cacheVariables": {
        "CKRE_BUILD_SHARED": "OFF",
        "CKRE_BUILD_STATIC": "ON",
        "CKRE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "renderengine-tests-msvc-x64",
      "displayName": "RenderEngine Tests (MSVC x64)",
      "description": "Build x64 v2 RenderEngine tests against static CKRenderEngine libraries.",
      "inherits": "renderengine-static-msvc-x64",
      "cacheVariables": {
        "CKRE_BUILD_SHARED": "OFF",
        "CKRE_BUILD_STATIC": "ON",
        "CKRE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "renderengine-runtime-win32-release",
      "displayName": "RenderEngine Runtime Win32 Release",
      "configurePreset": "renderengine-runtime-msvc-win32",
      "configuration": "Release"
    },
    {
      "name": "renderengine-runtime-x64-release",
      "displayName": "RenderEngine Runtime x64 Release",
      "configurePreset": "renderengine-runtime-msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "renderengine-static-win32-release",
      "displayName": "RenderEngine Static Win32 Release",
      "configurePreset": "renderengine-static-msvc-win32",
      "configuration": "Release"
    },
    {
      "name": "renderengine-static-x64-release",
      "displayName": "RenderEngine Static x64 Release",
      "configurePreset": "renderengine-static-msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "renderengine-tests-win32-release",
      "displayName": "RenderEngine Tests Win32 Release",
      "configurePreset": "renderengine-tests-msvc-win32",
      "configuration": "Release"
    },
    {
      "name": "renderengine-tests-x64-release",
      "displayName": "RenderEngine Tests x64 Release",
      "configurePreset": "renderengine-tests-msvc-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "renderengine-tests-win32-release",
      "displayName": "RenderEngine Tests Win32 Release",
      "configurePreset": "renderengine-tests-msvc-win32",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "renderengine-tests-x64-release",
      "displayName": "RenderEngine Tests x64 Release",
      "configurePreset": "renderengine-tests-msvc-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
